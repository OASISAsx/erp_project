generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  role         String      @default("user")
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model Department {
  id          String                     @id @default(cuid())
  code        String                     @unique
  name        String
  description String?
  isActive    Boolean                    @default(true) @map("is_active")
  users       User[]
  permissions DepartmentMenuPermission[]
  subMenuPermissions DepartmentSubMenuPermission[]
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  @@map("departments")
}

model ErpMenu {
  id          String                     @id @default(cuid())
  key         String                     @unique
  label       String
  description String
  subMenus    ErpSubMenu[]
  sortOrder   Int                        @default(0) @map("sort_order")
  isActive    Boolean                    @default(true) @map("is_active")
  permissions DepartmentMenuPermission[]
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  @@map("erp_menus")
}

model ErpSubMenu {
  id          String                        @id @default(cuid())
  menuId      String                        @map("menu_id")
  key         String                        @unique
  label       String
  description String
  path        String
  sortOrder   Int                           @default(0) @map("sort_order")
  isActive    Boolean                       @default(true) @map("is_active")
  menu        ErpMenu                       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permissions DepartmentSubMenuPermission[]
  createdAt   DateTime                      @default(now()) @map("created_at")
  updatedAt   DateTime                      @updatedAt @map("updated_at")

  @@map("erp_sub_menus")
}

model DepartmentMenuPermission {
  id           String     @id @default(cuid())
  departmentId String     @map("department_id")
  menuId       String     @map("menu_id")
  canView      Boolean    @default(true) @map("can_view")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  menu         ErpMenu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([departmentId, menuId])
  @@map("department_menu_permissions")
}

model DepartmentSubMenuPermission {
  id           String     @id @default(cuid())
  departmentId String     @map("department_id")
  subMenuId    String     @map("sub_menu_id")
  canView      Boolean    @default(true) @map("can_view")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subMenu      ErpSubMenu @relation(fields: [subMenuId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([departmentId, subMenuId])
  @@map("department_sub_menu_permissions")
}

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  purchaseOrders PurchaseOrder[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  unit        String   @default("ชิ้น")
  price       Decimal  @default(0) @db.Decimal(12, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  purchaseOrderItems PurchaseOrderItem[]
  serials     ProductSerial[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model DocumentCounter {
  id         String   @id @default(cuid())
  key        String   @unique
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("document_counters")
}

model MainStatus {
  id             String          @id @default(cuid())
  module         String
  code           String
  label          String
  description    String?
  color          String          @default("blue")
  sortOrder      Int             @default(0) @map("sort_order")
  isActive       Boolean         @default(true) @map("is_active")
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([module, code])
  @@index([module, isActive, sortOrder])
  @@map("main_statuses")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  customerId  String              @map("customer_id")
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status      String              @default("waiting_picking")
  mainStatusId String?            @map("main_status_id")
  mainStatus   MainStatus?        @relation(fields: [mainStatusId], references: [id], onDelete: SetNull)
  orderDate   DateTime            @default(now()) @map("order_date")
  note        String?
  subtotal    Decimal             @default(0) @db.Decimal(12, 2)
  total       Decimal             @default(0) @db.Decimal(12, 2)
  items       PurchaseOrderItem[]
  serials     ProductSerial[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String          @id @default(cuid())
  purchaseOrderId String          @map("purchase_order_id")
  productId       String          @map("product_id")
  quantity        Int
  unitPrice       Decimal         @map("unit_price") @db.Decimal(12, 2)
  amount          Decimal         @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  serials         ProductSerial[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("purchase_order_items")
}

model ProductSerial {
  id                  String             @id @default(cuid())
  serialNumber        String             @unique @map("serial_number")
  productId           String             @map("product_id")
  purchaseOrderId     String             @map("purchase_order_id")
  purchaseOrderItemId String             @map("purchase_order_item_id")
  warehouseLocation   String?            @map("warehouse_location")
  status              String             @default("in_stock")
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrder       PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@map("product_serials")
}
